# Resend (https://resend.com) — used to send contact form notification + auto-reply emails
RESEND_API_KEY=

# Address that receives new contact form submissions
CONTACT_TO_EMAIL=hello@studiomizani.com

# Verified sending address (must be on a domain verified in Resend)
# Use "onboarding@resend.dev" for local testing before studiomizani.com is verified
CONTACT_FROM_EMAIL=Studio Mizan <hello@studiomizani.com>
