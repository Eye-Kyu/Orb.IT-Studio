# Resend (https://resend.com) — used to send contact form notification + auto-reply emails
RESEND_API_KEY=

# Address that receives new contact form submissions
CONTACT_TO_EMAIL=hello@studiomizani.com

# Verified sending address (must be on a domain verified in Resend)
# Use "onboarding@resend.dev" for local testing before studiomizani.com is verified
CONTACT_FROM_EMAIL=Studio Mizani <hello@studiomizani.com>

# Optional — shows a "Book a 20-min call" button on /contact (e.g. a Cal.com link)
NEXT_PUBLIC_CAL_URL=

# Optional — raises GitHub API rate limits for the /now feed (read-only, public scope)
GITHUB_TOKEN=

# Optional — Google Search Console HTML-tag verification code (content="...")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
